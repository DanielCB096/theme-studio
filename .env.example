# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` al repositorio.

# --- Supabase (cliente) -------------------------------------------------
# Clave pública `anon`/`publishable`: puede ir en el bundle porque RLS protege los datos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Función serverless de IA (solo servidor) ---------------------------
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
# Sin prefijo VITE_: Vite no la expone al navegador. Vercel la inyecta en
# tiempo de ejecución de la función, nunca en el bundle del cliente.
GEMINI_API_KEY=
# Opcional. Si se deja vacío se usa el alias `gemini-flash-latest`.
GEMINI_MODEL=
